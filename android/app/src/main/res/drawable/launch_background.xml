<?xml version="1.0" encoding="utf-8"?>
<!-- The first frame the player sees. It matches the game's own background,
     so the launch screen does not flash white before the app draws. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/launch_ring" />
    </item>
</layer-list>
